# Production environment variables for backend (Render)
# Copy this to .env on Render's environment variable panel.

# PostgreSQL — replace with your Neon/Supabase connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-64-char-hex-secret"

# Port (Render sets this automatically; leave as default)
PORT=5000

# CORS — set to your Vercel frontend URL (no trailing slash)
FRONTEND_URL="https://your-app.vercel.app"

# Node environment
NODE_ENV="production"
